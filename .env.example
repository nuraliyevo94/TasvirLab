# ========================================================
# 🎬 TasvirLab — Muhit Sozlamalari Namunasi (.env.example)
# ========================================================
# Ushbu faylni .env nomiga nusxalang va o'z kalitlaringizni kiriting:
# cp .env.example .env

# 1. Sun'iy Intellekt (AI) Kalitlari
# Mohir AI (UzbekVoice Lola ustoz TTS): https://uzbekvoice.ai yoki https://mohir.ai
MOHIRAI_API_KEY=your_mohirai_api_key_here
# Google Gemini (Ssenariy va xavfsizlik tekshiruvi): https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Server va Xavfsizlik
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///tasvirlab.db
JWT_SECRET_KEY=change_this_to_a_super_secure_random_key_in_production
DEV_MODE=false

# 3. Foydalanuvchi va Balans Sozlamalari
INITIAL_FREE_CREDITS=3
CREDITS_PER_VIDEO=1

# 4. Administrator Hisobi
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password

# 5. Tashqi Autentifikatsiya (Google OAuth & Telegram)
# Google OAuth 2.0 Web Client ID: https://console.cloud.google.com
GOOGLE_CLIENT_ID=
# Telegram Bot (@BotFather):
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=tasvirlab_bot

# 6. SMS Shlyuzi (Eskiz.uz)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
OTP_EXPIRE_MINUTES=5

# 7. O'zbekiston To'lov Tizimlari (Billing & Merchant)
# Payme Merchant API: https://business.payme.uz
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# Click Merchant API: https://merchant.click.uz
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Uzum Bank Merchant API:
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

# Paynet Merchant API:
PAYNET_SERVICE_ID=
PAYNET_SECRET_KEY=

# 8. Bulutli Media Xotira (Ixtiyoriy - Cloudflare R2 / AWS S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tasvirlab-videos
R2_PUBLIC_DOMAIN=
