# KidsVidEdu Platform - Environment Variables Template
# Ushbu faylni nusxalab .env nomiga o'zgartiring va o'z kalitlaringizni kiriting:
# cp .env.example .env

# 1. Mohir AI (UzbekVoice) API Kaliti (O'zbekcha TTS ovoz sintezi uchun)
# Olish joyi: https://uzbekvoice.ai yoki https://mohir.ai
MOHIRAI_API_KEY=your_mohirai_api_key_here

# 2. Google Gemini AI API Kaliti (Bolalar xavfsizligi va pedagogik ssenariy uchun)
# Olish joyi: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Server sozlamalari (Ixtiyoriy)
PORT=8000
HOST=0.0.0.0
