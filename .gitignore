# ========================================================
# 🎬 TasvirLab — Git Ignore File
# ========================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.obj
*.o

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment configurations and Secrets
.env
.env.local
.env.*.local
*.env

# Allow the template to be committed
!.env.example

# SQLite Databases & Local Storage
*.db
*.sqlite
*.sqlite3
tasvirlab.db

# Generated Media, Audio, Video & Render Cache
static/renders/*
!static/renders/.gitkeep
output/*
!output/.gitkeep

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editor & IDE Settings
.idea/
.vscode/
*.swp
*.swo
*~

# Logs and Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test and Coverage Artifacts
.pytest_cache/
.coverage
htmlcov/
